+            QuestionsContext.get();
+        const safeAvailableCount =
+            Math.max(
+                Number(availableCount) || 0,
+                0
+            );
+
+        if (
+            ctx.smartSessionMetric ===
+            "tempo"
+        ) {
+            if (
+                ctx.smartTimeMinutes ===
+                null
+            ) {
+                return safeAvailableCount;
+            }
+
+            const targetMinutes =
+                Math.max(
+                    1,
+                    Number(
+                        ctx.smartTimeMinutes
+                    ) || 15
+                );
+            const timeBasedCount =
+                Math.max(
+                    1,
+                    Math.floor(
+                        (targetMinutes * 60) /
+                            25
+                    )
+                );
+
+            return safeAvailableCount
+                ? Math.min(
+                    timeBasedCount,
+                    safeAvailableCount
+                )
+                : timeBasedCount;
+        }
+
+        if (
+            ctx.smartQuestionCount === null
+        ) {
+            return safeAvailableCount;
+        }
+
+        const requestedCount =
+            Math.max(
+                1,
+                Number(
+                    ctx.smartQuestionCount ||
+                        ctx.quantidadeQuestoes
+                ) || 5
+            );
+
+        return safeAvailableCount
+            ? Math.min(
+                requestedCount,
+                safeAvailableCount
+            )
+            : requestedCount;
+    },
