+function normalizeCoverage(coverage, blocks = [], context = {}) {
+    const source = coverage && typeof coverage === "object"
+        ? coverage
+        : {};
+    const warnings = asArray(context.warnings)
+        .map((item) => cleanText(item))
+        .filter(Boolean);
+    const pageCount = Number(context.pageCount) || 0;
+    const frontsCovered = normalizeTextList(
+        source.frontsCovered && source.frontsCovered.length
+            ? source.frontsCovered
+            : blocks.map((block) => block && (block.title || block.subtitle || "")).filter(Boolean),
+        6
+    );
+    const possibleGaps = normalizeTextList(
+        source.possibleGaps && source.possibleGaps.length
+            ? source.possibleGaps
+            : warnings,
+        4
+    );
+    const sourceQualityRaw = cleanText(source.sourceQuality, "").toLowerCase();
+    const sourceQuality = ["alta", "media", "limitada"].includes(sourceQualityRaw)
+        ? sourceQualityRaw
+        : (
+            possibleGaps.length
+                ? "limitada"
+                : pageCount >= 80 && blocks.length <= 4
+                    ? "media"
+                    : "alta"
+        );
+    const summary = cleanText(
+        source.summary,
+        frontsCovered.length
+            ? `A trilha cobre ${frontsCovered.length} frente(s) principal(is) do material e organiza o estudo por recortes progressivos.`
+            : "A trilha organiza o material em recortes progressivos para abrir o estudo com clareza."
+    );
+
+    return {
+        summary,
+        sourceQuality,
+        frontsCovered,
+        possibleGaps
     };
 }
 
