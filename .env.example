# Mercado Pago - use credenciais de TESTE primeiro.
# Copie este arquivo para .env.local e preencha os valores reais.
# Nunca coloque o Access Token em arquivos JS, HTML ou CSS.

MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_CURRENCY=BRL

# Defina os valores do plano no servidor antes de testar o checkout.
# Use ponto decimal. Exemplo: 19.90
MERCADO_PAGO_MONTHLY_PRICE=
MERCADO_PAGO_ANNUAL_PRICE=

# URLs usadas quando conectarmos o checkout real no backend/serverless.
STUDY_OS_BASE_URL=http://127.0.0.1:5500
MERCADO_PAGO_SUCCESS_URL=http://127.0.0.1:5500/index.html?premiumPayment=success
MERCADO_PAGO_FAILURE_URL=http://127.0.0.1:5500/index.html?premiumPayment=failure
MERCADO_PAGO_PENDING_URL=http://127.0.0.1:5500/index.html?premiumPayment=pending
MERCADO_PAGO_NOTIFICATION_URL=

# Opcional no futuro: segredo interno para validar webhooks, se configurarmos um.
MERCADO_PAGO_WEBHOOK_SECRET=
