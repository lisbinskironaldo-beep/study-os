# Mercado Pago - use credenciais de TESTE primeiro.
# Copie este arquivo para .env.local e preencha os valores reais.
# Nunca coloque o Access Token em arquivos JS, HTML ou CSS.

MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_CURRENCY=BRL

# Defina os valores do plano no servidor antes de testar o checkout.
# Use ponto decimal. Exemplo: 19.90
MERCADO_PAGO_MONTHLY_PRICE=
MERCADO_PAGO_ANNUAL_PRICE=

# URLs usadas quando conectarmos o checkout real no backend/serverless.
PAPIRO_TOOLS_BASE_URL=http://127.0.0.1:5500
MERCADO_PAGO_SUCCESS_URL=http://127.0.0.1:5500/index.html?premiumPayment=success
MERCADO_PAGO_FAILURE_URL=http://127.0.0.1:5500/index.html?premiumPayment=failure
MERCADO_PAGO_PENDING_URL=http://127.0.0.1:5500/index.html?premiumPayment=pending
MERCADO_PAGO_NOTIFICATION_URL=

# Opcional no futuro: segredo interno para validar webhooks, se configurarmos um.
MERCADO_PAGO_WEBHOOK_SECRET=

# Fonte de verdade do premium.
# Use a Service Role Key apenas no ambiente do servidor/Vercel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PAPIRO_TOOLS_AUTH_SECRET=
GOOGLE_CLIENT_ID=
PAPIRO_TOOLS_GOOGLE_CLIENT_ID=

# Gemini para bundle do produto e copiloto da retaguarda.
GEMINI_API_KEY=
GEMINI_FREE_API_KEY=
GEMINI_PAID_API_KEY=
PAPIRO_TOOLS_AI_MODEL=gemini-2.5-flash-lite

# OpenAI / ChatGPT para acesso autorizado ao NorthStar via Apps SDK + MCP.
# OPENAI_API_KEY e opcional nesta fase; o circuito minimo usa app URL + MCP URL + MCP bearer.
OPENAI_API_KEY=
OPENAI_APP_PUBLIC_URL=
OPENAI_MCP_SERVER_URL=
OPENAI_MCP_API_KEY=

# GitHub para automacoes operacionais.
GITHUB_TOKEN=

# Google Ads para campanhas, relatorios e automacoes futuras.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_MANAGER_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_SERVICE_ACCOUNT_KEY=

# Meta Ads para campanhas externas e insights.
META_APP_ID=
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Conectores de divulgacao organica.
# Canva exige app/OAuth para automacao real; brand template ajuda a gerar artes padronizadas.
CANVA_CONNECT_CLIENT_ID=
CANVA_CONNECT_CLIENT_SECRET=
CANVA_BRAND_TEMPLATE_ID=
CANVA_BRAND_KIT_ID=

# Buffer permite transformar rascunhos aprovados em posts agendados quando houver token/canais.
# Use BUFFER_API_KEY preferencialmente; BUFFER_ACCESS_TOKEN fica aceito para compatibilidade.
BUFFER_API_KEY=
BUFFER_ACCESS_TOKEN=
BUFFER_ORGANIZATION_ID=
BUFFER_PROFILE_IDS=

# Publer API costuma exigir plano Business/Enterprise.
PUBLER_API_KEY=
PUBLER_WORKSPACE_ID=

# Retaguarda /ops
OPS_PANEL_PASSWORD=
OPS_SESSION_SECRET=
OPS_ALERT_SECRET=
OPS_COPILOT_ENABLED=true
OPS_COPILOT_DEFAULT_MODEL=gemini-2.5-flash-lite
OPS_COPILOT_STRATEGY_MODEL=gemini-2.5-flash
OPS_PROMOTION_MODE=suggest
OPS_PROMOTION_CHANNELS=internal_site,meta_ads,google_ads
CRON_SECRET=
